# Reproducible source for this checkout's target kernel, Ubuntu Linux 7.0.
#
# Ubuntu package: linux-source-7.0.0 version 7.0.0-34.34. Its kernel tree
# Makefile reports upstream release 7.0.14. The pristine source file hashes
# below are checked before patches/csr8510-fix-7.0.patch is applied.
#
# Install the package or point KERNEL_SOURCE_ARCHIVE at its source tarball:
#   sudo apt install linux-source-7.0.0
#   scripts/verify.sh 7.0

variant             7.0
source-package      linux-source-7.0.0
source-version      7.0.0-34.34
source-release      7.0.14
source-archive      /usr/src/linux-source-7.0.0.tar.bz2
source-root         linux-source-7.0.0
patch               patches/csr8510-fix-7.0.patch

